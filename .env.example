# mock = no Tally needed (in-process simulated Tally). real = talk to TallyPrime over HTTP.
TALLY_MODE=mock
# TallyPrime XML server (F1 Help > Settings > Connectivity: "TallyPrime acts as Server", port 9000)
TALLY_URL=http://localhost:9000
# Exact company name as shown in Tally (company must be OPEN in Tally)
TALLY_COMPANY=Demo Sync Co
TALLY_TIMEOUT_MS=30000
# Voucher period for exports (YYYYMMDD)
TALLY_FROM_DATE=20260401
TALLY_TO_DATE=20270331
# Prefix for voucher numbers created by this app (used for idempotency)
VOUCHER_PREFIX=TT
PORT=4000
# 0 = off. Otherwise push+pull every N seconds
AUTO_SYNC_SECONDS=0
# DB_PATH=./data/tallytesting.db
# MOCK_STATE_PATH=./data/mock-tally-state.json
