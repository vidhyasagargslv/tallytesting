<ENVELOPE>
  <HEADER>
    <VERSION>1</VERSION>
    <TALLYREQUEST>Export</TALLYREQUEST>
    <TYPE>Collection</TYPE>
    <ID>TT Voucher Export</ID>
  </HEADER>
  <BODY>
    <DESC>
      <STATICVARIABLES>
        <SVEXPORTFORMAT>$$SysName:XML</SVEXPORTFORMAT>
        <SVCURRENTCOMPANY>__COMPANY__</SVCURRENTCOMPANY>
        <SVFROMDATE TYPE="Date">__FROM__</SVFROMDATE><SVTODATE TYPE="Date">__TO__</SVTODATE>
      </STATICVARIABLES>
      <TDL>
        <TDLMESSAGE>
          <COLLECTION NAME="TT Voucher Export" ISMODIFY="No" ISFIXED="No" ISINITIALIZE="No" ISOPTION="No" ISINTERNAL="No">
            <TYPE>Voucher</TYPE>
            
            <FETCH>GUID</FETCH>
            <FETCH>MasterID</FETCH>
            <FETCH>AlterID</FETCH>
            <FETCH>Name</FETCH>
            <FETCH>VoucherNumber</FETCH>
            <FETCH>VoucherTypeName</FETCH>
            <FETCH>Date</FETCH>
            <FILTER>TTFilter</FILTER>
          </COLLECTION>
          <SYSTEM TYPE="Formulae" NAME="TTFilter">($VoucherNumber = &quot;TT/TEST/0001&quot; AND $VoucherTypeName = &quot;Sales&quot;)</SYSTEM>
        </TDLMESSAGE>
      </TDL>
    </DESC>
  </BODY>
</ENVELOPE>
