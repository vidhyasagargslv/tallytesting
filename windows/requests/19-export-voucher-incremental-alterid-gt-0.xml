<ENVELOPE>
  <HEADER>
    <VERSION>1</VERSION>
    <TALLYREQUEST>Export</TALLYREQUEST>
    <TYPE>Collection</TYPE>
    <ID>TT Voucher Export</ID>
  </HEADER>
  <BODY>
    <DESC>
      <STATICVARIABLES>
        <SVEXPORTFORMAT>$$SysName:XML</SVEXPORTFORMAT>
        <SVCURRENTCOMPANY>__COMPANY__</SVCURRENTCOMPANY>
        <SVFROMDATE TYPE="Date">__FROM__</SVFROMDATE><SVTODATE TYPE="Date">__TO__</SVTODATE>
      </STATICVARIABLES>
      <TDL>
        <TDLMESSAGE>
          <COLLECTION NAME="TT Voucher Export" ISMODIFY="No" ISFIXED="No" ISINITIALIZE="No" ISOPTION="No" ISINTERNAL="No">
            <TYPE>Voucher</TYPE>
            <NATIVEMETHOD>*</NATIVEMETHOD>
            <FETCH>*</FETCH>
            <FETCH>AllLedgerEntries</FETCH>
            <FETCH>LedgerEntries</FETCH>
            <FETCH>AllInventoryEntries</FETCH>
            <FETCH>InventoryEntries</FETCH>
            <FETCH>AllLedgerEntries.BillAllocations</FETCH>
            <FETCH>AllInventoryEntries.BatchAllocations</FETCH>
            <FETCH>AllInventoryEntries.AccountingAllocations</FETCH>
            <FILTER>TTFilter</FILTER>
          </COLLECTION>
          <SYSTEM TYPE="Formulae" NAME="TTFilter">($AlterID &gt; 1)</SYSTEM>
        </TDLMESSAGE>
      </TDL>
    </DESC>
  </BODY>
</ENVELOPE>
