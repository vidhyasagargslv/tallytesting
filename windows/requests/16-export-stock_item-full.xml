            <FETCH>*</FETCH>
            <FETCH>OpeningBalance</FETCH>
            <FETCH>OpeningValue</FETCH>
            <FETCH>OpeningRate</FETCH>
            <FETCH>ClosingBalance</FETCH>
            <FETCH>ClosingValue</FETCH>
            <FETCH>ClosingRate</FETCH>
            <FETCH>BatchAllocations</FETCH>
            <FETCH>GSTDetails</FETCH>
            
          </COLLECTION>
          
        </TDLMESSAGE>
      </TDL>
    </DESC>
  </BODY>
</ENVELOPE>
